@TypeBEulerianVerification.real_rooted : ∀ {P : ℕ → ℝ[X]},
  TypeBEulerianVerification.IsTypeBEulerian P →
    ∀ (L : ℝ[X] →ₗ[ℝ] ℝ[X]),
      (∀ (m : ℕ), L (X ^ m) = P m) →
        ∀ (n : ℕ) (c : Fin (n + 1) → ℝ),
          (∀ (k : Fin (n + 1)), 0 ≤ c k) → c ≠ 0 → (L (∑ k, c k • (X ^ (n - ↑k) * (1 + X) ^ ↑k))).Splits
@TypeBEulerianVerification.real_rooted_strong : ∀ {P : ℕ → ℝ[X]},
  TypeBEulerianVerification.IsTypeBEulerian P →
    ∀ (L : ℝ[X] →ₗ[ℝ] ℝ[X]),
      (∀ (m : ℕ), L (X ^ m) = P m) →
        ∀ (n : ℕ) (c : Fin (n + 1) → ℝ),
          (∀ (k : Fin (n + 1)), 0 ≤ c k) →
            c ≠ 0 →
              have p := L (∑ k, c k • (X ^ (n - ↑k) * (1 + X) ^ ↑k));
              p ≠ 0 ∧ p.Splits ∧ p.natDegree = n ∧ p.roots.card = n ∧ ∀ r ∈ p.roots, r < 0
TypeBEulerianVerification.zero_vector : ∀ (L : ℝ[X] →ₗ[ℝ] ℝ[X]) (n : ℕ), L (∑ k, 0 • (X ^ (n - ↑k) * (1 + X) ^ ↑k)) = 0
@TypeBEulerianVerification.degree_zero : ∀ {P : ℕ → ℝ[X]},
  TypeBEulerianVerification.IsTypeBEulerian P →
    ∀ (L : ℝ[X] →ₗ[ℝ] ℝ[X]),
      (∀ (m : ℕ), L (X ^ m) = P m) → ∀ (c : Fin 1 → ℝ), L (∑ k, c k • (X ^ (0 - ↑k) * (1 + X) ^ ↑k)) = C (c 0)
@TypeBEulerianVerification.basis_image : ∀ {P : ℕ → ℝ[X]},
  TypeBEulerianVerification.IsTypeBEulerian P →
    ∀ (L : ℝ[X] →ₗ[ℝ] ℝ[X]),
      (∀ (m : ℕ), L (X ^ m) = P m) →
        ∀ {n k : ℕ}, k ≤ n → L (X ^ (n - k) * (1 + X) ^ k) = ∑ j ∈ Finset.range (k + 1), ↑(k.choose j) • P (n - j)
TypeBEulerianVerification.sequence_exists : ∃ P,
  TypeBEulerianVerification.IsTypeBEulerian P ∧ P 1 = 1 + X ∧ P 2 = 1 + 6 * X + X ^ 2
@TypeBEulerianVerification.map_exists : ∀ {P : ℕ → ℝ[X]},
  TypeBEulerianVerification.IsTypeBEulerian P → ∃ L, ∀ (m : ℕ), L (X ^ m) = P m
TypeBEulerian.mathcalB_coneInput_splits : ∀ (n : ℕ) (c : Fin (n + 1) → ℝ),
  (∀ (k : Fin (n + 1)), 0 ≤ c k) → c ≠ 0 → (TypeBEulerian.mathcalB (∑ k, c k • (X ^ (n - ↑k) * (1 + X) ^ ↑k))).Splits
TypeBEulerian.mathcalB_coneInput_realRooted : ∀ (n : ℕ) (c : Fin (n + 1) → ℝ),
  (∀ (k : Fin (n + 1)), 0 ≤ c k) →
    c ≠ 0 →
      TypeBEulerian.mathcalB (TypeBEulerian.coneInput n c) ≠ 0 ∧
        (TypeBEulerian.mathcalB (TypeBEulerian.coneInput n c)).Splits ∧
          (TypeBEulerian.mathcalB (TypeBEulerian.coneInput n c)).natDegree = n ∧
            (TypeBEulerian.mathcalB (TypeBEulerian.coneInput n c)).roots.card = n ∧
              ∀ r ∈ (TypeBEulerian.mathcalB (TypeBEulerian.coneInput n c)).roots, r < 0
